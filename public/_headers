# ترويسات التخزين المؤقت على Cloudflare
#
# الملفات ذات الأسماء المبصومة (assets/*) لا تتغيّر محتوياتها أبداً،
# فتُخزَّن للأبد. أما الملفات الثابتة الأسماء فيجب ألا تُخزَّن إطلاقاً،
# وأهمها sw.js: هو من يقرّر أي نسخة يراها المستخدم، فإن خُزِّن هو نفسه
# بقي التطبيق على نسخة قديمة مهما نشرنا من تحديثات.

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache

/registerSW.js
  Cache-Control: no-cache, no-store, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
